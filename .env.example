# Copy this file to .env for local development. Never commit .env.
# On Hostinger, set the same names in the Node.js app environment. Do not put real secrets in this file.

# Public site origin, no trailing slash. Required for Ziina return URLs on a custom domain.
# Server-side. Example: https://your-domain.com
SITE_URL=

# Same public origin, read when the production build creates canonical tags and sitemap.xml.
# Intentionally public. Set it before npm run build.
VITE_SITE_URL=

# Supabase project URL. Server and build. Example: https://YOUR_PROJECT.supabase.co
SUPABASE_URL=
# Same URL, inlined into the browser bundle. Public by design.
VITE_SUPABASE_URL=

# Supabase publishable key (anon or sb_publishable_). Safe to expose in the browser.
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role / secret key. Server only. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional project id used by local tooling. Not required at runtime.
SUPABASE_PROJECT_ID=
VITE_SUPABASE_PROJECT_ID=

# Ziina secret. Server only. Never prefix with VITE_.
ZIINA_API_KEY=
# Optional. true creates Ziina test payment links that do not charge a card. Leave false in production.
ZIINA_TEST_MODE=false
